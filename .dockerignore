# Keep the build context (and therefore the image) small and free of
# dev/test cruft, secrets, and personal content (spec §8.1, §12).

.git
.gitignore
.github

.venv/
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
.tools/

tests/
docs/
design-system/
.superpowers/
scripts/
Makefile
HANDOFF-BRIEF.md
KICKOFF.txt

# Personal content / operator state - never belongs in the image.
snapshots/
config.yml
config.yaml
.env
*.env
!config.example.yml
*.m4a
*.mp3
*.opus
*.webm
cache/
data/

# Build output that gets produced fresh inside the image anyway.
boxbutler/web/static/app.css

# Compose examples aren't needed inside the image itself.
compose/

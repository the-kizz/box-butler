# Box Butler — environment template (spec §7, §8.1).
#
# Names only. NEVER put a real credential in this file — it is committed
# to a public repository. Copy it to `.env` next to your compose file,
# fill in real values there, and make sure `.env` is gitignored (it is,
# by this repo's own .gitignore pattern `*.env`).
#
# Required — the process refuses to start without both:
BOXBUTLER_SINK_USER=
BOXBUTLER_SINK_PASSWORD=
BOXBUTLER_ADMIN_USER=
BOXBUTLER_ADMIN_PASSWORD=changeme

# Optional — omit it and a session-signing key is generated on first
# start and stored in the data volume (<data_dir>/secret_key), so it
# survives restarts. Set it yourself only if you want to manage it.
BOXBUTLER_SECRET_KEY=

# Optional secret — only needed if your ntfy server requires a bearer token.
BOXBUTLER_NOTIFY_TOKEN=

# Optional overrides — env beats config.yml for every setting, not just secrets.
# BOXBUTLER_DATA_DIR=/data
# BOXBUTLER_CACHE_DIR=/cache
# BOXBUTLER_MEDIA_ROOT=/media
# BOXBUTLER_CONFIG=
# BOXBUTLER_SINK_KIND=tonies_cloud
